/virt/
/ipc/
/init/
# T0-S arch (top-level Kconfig/Makefile kept by the top_only pair, L5-63)
/arch/arm64/*
!/arch/arm64/*/
/arch/arm64/kernel/
/arch/arm64/kvm/
/arch/arm64/mm/
/arch/arm64/include/
/arch/arm64/lib/
