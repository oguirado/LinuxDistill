kvm.h::KVM_ARM_DEVICE_TYPE_MASK","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_DEVICE_ID_SHIFT","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_DEVICE_ID_MASK"],"text":"Device identifier encoding splits a 32-bit value into a low 16-bit type field starting at bit 0 and a high 16-bit instance field starting at bit 16, each with a mask covering its half."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_DEVICE_VGIC_V2","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V2_ADDR_TYPE_DIST","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V2_ADDR_TYPE_CPU","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V2_DIST_SIZE","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V2_CPU_SIZE"],"text":"Second-generation interrupt controller device uses type id 0, address kinds distributor 0 and CPU interface 1, and mapping sizes 4K for distributor and 8K for CPU interface."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V3_ADDR_TYPE_DIST","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V3_ADDR_TYPE_REDIST","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_ITS_ADDR_TYPE","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V3_ADDR_TYPE_REDIST_REGION","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V3_DIST_SIZE","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V3_REDIST_SIZE","arch/arm64/include/uapi/asm/kvm.h::KVM_VGIC_V3_ITS_SIZE"],"text":"Third-generation controller addressing uses distributor 2, redistributor 3, ITS 4 and redistributor region 5; distributor spans one 64K unit while redistributor and ITS each span two such units."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_POWER_OFF","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_EL1_32BIT","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_PSCI_0_2","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_PMU_V3","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_SVE","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_PTRAUTH_ADDRESS","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_PTRAUTH_GENERIC","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_HAS_EL2","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_HAS_EL2_E2H0","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_VCPU_PMU_V3_STRICT"],"text":"VCPU creation feature indexes are POWER_OFF 0, EL1_32BIT 1, PSCI_0_2 2, PMU_V3 3, SVE 4, PTRAUTH_ADDRESS 5, PTRAUTH_GENERIC 6, HAS_EL2 7, HAS_EL2_E2H0 8 and PMU_V3_STRICT 9."},{"kind":"struct","sids":["arch/arm64/include/uapi/asm/kvm.h::kvm_vcpu_init","arch/arm64/include/uapi/asm/kvm.h::kvm_sregs","arch/arm64/include/uapi/asm/kvm.h::kvm_fpu"],"text":"VCPU setup carries a 32-bit target plus seven 32-bit feature words; special register and floating point containers are currently empty placeholders."},{"kind":"struct","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_MAX_DBG_REGS","arch/arm64/include/uapi/asm/kvm.h::kvm_guest_debug_arch","arch/arm64/include/uapi/asm/kvm.h::KVM_DEBUG_ARCH_HSR_HIGH_VALID","arch/arm64/include/uapi/asm/kvm.h::kvm_debug_exit_arch"],"text":"Hardware debug support allows sixteen entries per class; guest debug state holds four parallel arrays for breakpoint and watchpoint controls and values, while debug exit state holds low exception syndrome, optional high half and fault address, with bit 0 flagging high-half validity."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_GUESTDBG_USE_SW_BP","arch/arm64/include/uapi/asm/kvm.h::KVM_GUESTDBG_USE_HW","arch/arm64/include/uapi/asm/kvm.h::kvm_sync_regs"],"text":"Guest debug mode selects software breakpoints at bit 16 and hardware assistance at bit 17; synchronized register state is a single 64-bit device IRQ level."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_DEV_EL1_VTIMER","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_DEV_EL1_PTIMER","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_DEV_PMU"],"text":"Virtual device interrupt identifiers use single bits: EL1 virtual timer bit 0, EL1 physical timer bit 1, performance monitor bit 2."},{"kind":"struct","sids":["arch/arm64/include/uapi/asm/kvm.h::kvm_pmu_event_filter","arch/arm64/include/uapi/asm/kvm.h::KVM_PMU_EVENT_ALLOW","arch/arm64/include/uapi/asm/kvm.h::KVM_PMU_EVENT_DENY"],"text":"Performance event filtering describes a range by 16-bit base and count, then an 8-bit action where allow is 0 and deny is 1, followed by three padding bytes."},{"kind":"struct","sids":["arch/arm64/include/uapi/asm/kvm.h::kvm_vcpu_events","arch/arm64/include/uapi/asm/kvm.h::kvm_vcpu_events.anon_1"],"text":"Pending exception state packs three single-byte pending and valid flags plus five alignment bytes and a 64-bit syndrome, with twelve reserved words after it."},{"kind":"struct","sids":["arch/arm64/include/uapi/asm/kvm.h::kvm_arm_copy_mte_tags"],"text":"Memory-tag transfer describes a guest address, byte length, user buffer pointer, control flags and two reserved words, all 64-bit aligned."},{"kind":"struct","sids":["arch/arm64/include/uapi/asm/kvm.h::kvm_arm_counter_offset","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_TAGS_TO_GUEST","arch/arm64/include/uapi/asm/kvm.h::KVM_ARM_TAGS_FROM_GUEST"],"text":"Counter offset state is two 64-bit words with the offset first and reserved second; tag copy direction uses 0 toward guest and 1 from guest."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_COPROC_MASK","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_COPROC_SHIFT","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_CORE","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_CORE_REG","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_DEMUX","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_DEMUX_ID_MASK","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_DEMUX_ID_SHIFT","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_DEMUX_ID_CCSIDR","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_DEMUX_VAL_MASK","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_DEMUX_VAL_SHIFT"],"text":"Register identifiers reserve bits 16 to 27 for a coprocessor class; core registers use class 0x10 with index derived from field byte offset divided by four, while demultiplexed registers use class 0x11 with an 8-bit selector at shift 8 and 8-bit value at shift 0, including a cache-size selector of zero."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_OP0_MASK","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_OP0_SHIFT","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_OP1_MASK","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_OP1_SHIFT","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_CRN_MASK","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_CRN_SHIFT","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_CRM_MASK","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_CRM_SHIFT","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_OP2_MASK","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SYSREG_OP2_SHIFT","arch/arm64/include/uapi/asm/kvm.h::ARM64_SYS_REG_SHIFT_MASK","arch/arm64/include/uapi/asm/kvm.h::__ARM64_SYS_REG","arch/arm64/include/uapi/asm/kvm.h::ARM64_SYS_REG"],"text":"System register identifiers use class 0x13 and pack Op0 at shift 14, Op1 at 11, CRn at 7, CRm at 3 and Op2 at 0 with matching masks; a constructor shifts each operand into place and forces 64-bit ARM64 encoding."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_PTIMER_CTL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_PTIMER_CVAL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_PTIMER_CNT","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_TIMER_CTL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_TIMER_CVAL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_TIMER_CNT"],"text":"Architected timer registers expose separate physical and virtual control, compare and count views built from fixed encoding tuples."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_FW","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_FW_REG","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_PSCI_VERSION","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_1","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_1_NOT_AVAIL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_1_AVAIL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_1_NOT_REQUIRED"],"text":"Firmware pseudo-registers use class 0x14 with low 16 bits selecting index and forced 64-bit size; index 0 reports PSCI version and index 1 reports first workaround state as not-available 0, available 1 or not-required 2."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_2","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_2_NOT_AVAIL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_2_UNKNOWN","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_2_AVAIL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_2_NOT_REQUIRED","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_2_ENABLED","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_3","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_3_NOT_AVAIL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_3_AVAIL","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM_SMCCC_ARCH_WORKAROUND_3_NOT_REQUIRED"],"text":"Further workaround states use indexes 2 and 3; index 2 reports not-available 0, unknown 1, available 2, not-required 3 plus an enabled flag at bit 4, while index 3 reports not-available 0, available 1 or not-required 2."},{"kind":"abi_constant","sids":["arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SVE","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SVE_ZREG_BASE","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SVE_PREG_BASE","arch/arm64/include/uapi/asm/kvm.h::KVM_REG_ARM64_SVE_FFR_BASE","arch/arm64/include/u