lude/trace/events/ksm.h::TRACE_SYSTEM","include/trace/events/ksm.h::_TRACE_KSM_H","include/trace/events/kyber.h::TRACE_SYSTEM","include/trace/events/kyber.h::_TRACE_KYBER_H.alt_1","include/trace/events/kyber.h::_TRACE_KYBER_H.alt_2","include/trace/events/landlock.h::TRACE_SYSTEM","include/trace/events/landlock.h::_TRACE_LANDLOCK_H","include/trace/events/lock.h::TRACE_SYSTEM","include/trace/events/lock.h::_TRACE_LOCK_H","include/trace/events/maple_tree.h::TRACE_SYSTEM","include/trace/events/maple_tree.h::_TRACE_MM_H"],"text":"Each routed trace header declares a subsystem label for event grouping and a private include guard that prevents multiple inclusion."},{"kind":"export","sids":["include/trace/events/dma.h::decode_dma_data_direction","include/trace/events/dma.h::decode_dma_attrs","include/trace/events/dma.h::DEFINE_MAP_EVENT","include/trace/events/dma.h::DEFINE_UNMAP_EVENT","include/trace/events/dma.h::DEFINE_ALLOC_EVENT","include/trace/events/dma.h::DEFINE_FREE_EVENT","include/trace/events/dma.h::DEFINE_SYNC_SINGLE_EVENT","include/trace/events/dma.h::DEFINE_SYNC_SG_EVENT"],"text":"DMA tracepoints provide paired generators for mapping, unmapping, coherent allocation, freeing and synchronization of single addresses and scatter lists, each carrying device context with addresses, lengths, transfer direction and attribute flags where relevant, plus helpers that render direction and attribute codes as readable names."},{"kind":"state_machine","sids":["include/trace/events/dma.h::DEFINE_MAP_EVENT","include/trace/events/dma.h::DEFINE_UNMAP_EVENT","include/trace/events/dma.h::DEFINE_ALLOC_EVENT","include/trace/events/dma.h::DEFINE_FREE_EVENT","include/trace/events/dma.h::DEFINE_SYNC_SINGLE_EVENT","include/trace/events/dma.h::DEFINE_SYNC_SG_EVENT"],"text":"Direct memory access buffers move through allocation or mapping, optional synchronization, then unmapping or freeing, with trace generators observing each transition and preserving direction and attribute context across