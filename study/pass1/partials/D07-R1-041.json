te_lock_shared","include/linux/fs.h::filemap_invalidate_unlock","include/linux/fs.h::filemap_invalidate_unlock_shared","include/linux/fs.h::i_size_read","include/linux/mm.h::PAGE_ALIGNED","include/linux/mm.h::folio_nr_pages","include/linux/mm.h::folio_put","arch/arm64/kvm/arm.c::kvm_arch_irqchip_in_kernel","arch/arm64/kvm/nested.c::kvm_arch_flush_shadow_all","arch/arm64/kvm/vgic/vgic-irqfd.c::kvm_set_msi","include/asm-generic/rwonce.h::WRITE_ONCE","include/linux/compat.h::is_compat_task","include/linux/fortify-string.h::memset","include/linux/fs.h::alloc_inode_sb","include/linux/fs.h::fops_get","include/linux/fs.h::fops_put","include/linux/highmem.h::clear_highpage","include/linux/kconfig.h::IS_ENABLED","include/linux/list.h::INIT_LIST_HEAD","include/linux/list.h::list_add","include/linux/list.h::list_del","include/linux/mempolicy.h::mpol_free_shared_policy","include/linux/mempolicy.h::mpol_shared_policy_init","include/linux/mutex.h::mutex_lock","arch/arm64/kvm/arm.c::kvm_arch_sync_dirty_log","arch/arm64/kvm/mmu.c::kvm_arch_mmu_enable_log_dirty_pt_masked","include/linux/build_bug.h::BUILD_BUG_ON","include/linux/pid.h::task_pid_nr","include/linux/refcount.h::refcount_dec_and_test","include/linux/slab.h::kzalloc_obj","include/linux/spinlock.h::spin_lock","include/linux/spinlock.h::spin_unlock","include/linux/spinlock_rt.h::spin_lock","include/linux/spinlock_rt.h::spin_unlock","include/linux/uaccess.h::copy_to_user","arch/arm64/kvm/arm.c::kvm_arch_alloc_vm","arch/arm64/kvm/arm.c::kvm_arch_destroy_vm","arch/arm64/kvm/arm.c::kvm_arch_init_vm","include/asm-generic/bug.h::WARN_ON.alt_1","include/asm-generic/bug.h::WARN_ON.alt_2","include/asm-generic/bug.h::WARN_ON.alt_3","include/linux/atomic/atomic-instrumented.h::atomic_long_fetch_andnot","include/linux/atomic/atomic-instrumented.h::atomic_long_set","include/linux/atomic/atomic-instrumented.h::xchg","include/linux/cleanup.h::guard","include/linux/debugfs.h::debugfs_create_dir","include/linux/debugfs.h::debugfs_create_file.alt_1"],"text":"External helpers are contract-only here: warn, container, file, inode, folio, list, policy, compat, atomics, locks, memory, debugfs, arch VM, dirty, irqchip and MSI; internals elsewhere."}],"invariants":[{"sids":["virt/kvm/guest_memfd.c::kvm_gmem_fallocate","virt/kvm/guest_memfd.c::kvm_gmem_allocate","virt/kvm/guest_memfd.c::kvm_gmem_punch_hole","virt/kvm/guest_memfd.c::kvm_gmem_fault_user_mapping","virt/kvm/guest_memfd.c::kvm_gmem_mmap","virt/kvm/guest_memfd.c::kvm_gmem_vm_ops","virt/kvm/guest_memfd.c::kvm_gmem_set_policy","virt/kvm/guest_memfd.c::kvm_gmem_get_policy"],"text":"Fallocate is keep-size only with aligned bounds. Allocate rejects past-size, aborts on signal, walks folios. Punch pairs invalidation round truncate. Fault rejects bad, private or large then installs locked. Map needs shared flags."},{"sids":["virt/kvm/guest_memfd.c::__kvm_gmem_create","virt/kvm/guest_memfd.c::kvm_gmem_init_inode_once","virt/kvm/guest_memfd.c::kvm_gmem_alloc_inode","virt/kvm/guest_memfd.c::kvm_gmem_destroy_inode","virt/kvm/guest_memfd.c::kvm_gmem_free_inode","virt/kvm/guest_memfd.c::kvm_gmem_inode_cachep"],"text":"Creation orders descriptor, state, inode, file and registration with reverse unwind. Inode splits one-time VFS init from policy, flags and list setup with matching teardown."},{"sids":["virt/kvm/kvm_main.c::kvm_handle_hva_range","virt/kvm/kvm_main.c::kvm_for_each_memslot_in_hva_range","virt/kvm/kvm_main.c::kvm_mmu_notifier_range","virt/kvm/kvm_main.c::gfn_handler_t","virt/kvm/kvm_main.c::on_lock_fn_t","virt/kvm/kvm_main.c::kvm_null_fn","virt/kvm/kvm_main.c::IS_KVM_NULL_FN","virt/kvm/kvm_main.c::kvm_age_hva_range","virt/kvm/kvm_main.c::kvm_age_hva_range_no_flush","virt/kvm/pfncache.c::gfn_to_pfn_cache_invalidate_start","virt/kvm/kvm_main.c::kvm_mmu_notifier_invalidate_range_end","virt/kvm/kvm_main.c::kvm_mmu_notifier_clear_flush_young","virt/kvm/kvm_main.c::kvm_mmu_notifier_clear_young","virt/kvm/kvm_main.c::kvm_mmu_notifier_test_young","virt/kvm/kvm_main.c::kvm_mmu_notifier_release"],"text":"Walks reject empty ranges, need handler or lock hook, forbid lock hook when lockless, clip overlaps. Null marks placeholder. Aging shares delegation. Overlap needs usable page in interval. Release flushes; end wakes at zero."},{"sids":["virt/kvm/kvm_main.c::kvm_vcpu_init","virt/kvm/kvm_main.c::kvm_flush_shadow_all","virt/kvm/kvm_main.c::ack_kick","virt/kvm/kvm_main.c::kvm_init_pm_notifier.alt_1","virt/kvm/kvm_main.c::kvm_init_pm_notifier.alt_2","virt/kvm/kvm_main.c::kvm_create_vm","virt/kvm/kvm_mm.h::KVM_MMU_LOCK_INIT.alt_1","virt/kvm/kvm_mm.h::KVM_MMU_LOCK_INIT.alt_2","virt/kvm/kvm_main.c::kvm_create_vm_debugfs"],"text":"VCPU init links VM, clears state, registers preemption and formats stats id; flush delegates; kick ack no-ops. PM is inert or maximal registration. VM seeds generations, poisons debug handle, checks slot count; MMU init varies by build."},{"sids":["virt/kvm/kvm_main.c::kvm_get_dirty_log","virt/kvm/kvm_main.c::kvm_get_dirty_log_protect","virt/kvm/kvm_main.c::kvm_clear_dirty_log_protect","virt/kvm/kvm_main.c::kvm_pre_set_memory_attributes","virt/kvm/kvm_main.c::kvm_vm_set_mem_attributes"],"text":"Dirty encodes space and slot; rejects bad space, missing slot or bitmap, and ring VMs. Clear needs 64-page alignment and containment. Null means absent attrs; present are small ints. Pre-change records interval then asks arch."}],"locks":[{"sids":["virt/kvm/guest_memfd.c::kvm_gmem_punch_hole","virt/kvm/guest_memfd.c::kvm_gmem_allocate","virt/kvm/guest_memfd.c::kvm_gmem_release","virt/kvm/guest_memfd.c::kvm_gmem_error_folio","virt/kvm/guest_memfd.c::kvm_gmem_invalidate_start","virt/kvm/guest_memfd.c::__kvm_gmem_invalidate_end","virt/kvm/guest_memfd.c::kvm_gmem_invalidate_end"],"text":"Truncation uses filemap locks: punch and release exclusive, allocate and error shared. Release holds slot mutex while clearing bindings and invalidating full range. End locks MMU only on overlapping present entries."},{"sids":["virt/kvm/kvm_main.c::kvm_handle_hva_range","virt/kvm/kvm_main.c::kvm_mmu_notifier_invalidate_range_start","virt/kvm/pfncache.c::gfn_to_pfn_cache_invalidate_start","virt/kvm/kvm_main.c::kvm_handle_gfn_range"],"text":"Walks hold source read cover, take MMU lazily on first overlap, skip null handlers. Start bumps counter under spinlock before unmap. Cache scan holds VM spin with shared then exclusive checks. GFN flushes only on effect."},{"sids":["virt/kvm/kvm_main.c::kvm_create_vm_debugfs","virt/kvm/kvm_main.c::kvm_create_vm","virt/kvm/kvm_main.c::kvm_trylock_all_vcpus","virt/kvm/kvm_main.c::kvm_vm_ioctl_set_memory_region","virt/kvm/kvm_main.c::kvm_vm_ioctl_get_dirty_log","virt/kvm/kvm_main.c::kvm_vm_ioctl_clear_dirty_log","virt/kvm/kvm_main.c::kvm_get_dirty_log_protect","virt/kvm/kvm_main.c::kvm_clear_dirty_log_protect"],"text":"VM prepares control, slot, invalidation and cache guards. Debug lookup uses local mutex. Bulk VCPU needs VM mutex, unwinds on contention. Region and dirty ioctls hold slot mutex; harvest holds MMU with flush after release."}],"pass":1,"phase_map":[{"anchor":"HB-KPAPER-001/hb-s5.p04","crown":"A","phase":"F2"}],"schema":"lx.dossier.v1","state_machines":[{"sids":["virt/kvm/guest_memfd.c::kvm_gmem_punch_hole","virt/kvm/guest_memfd.c::kvm_gmem_error_folio","virt/kvm/guest_memfd.c::kvm_gmem_release","virt/kvm/guest_memfd.c::kvm_gmem_invalidate_start","virt/kvm/guest_memfd.c::kvm_gmem_invalidate_end","virt/kvm/guest_memfd.c::kvm_gmem_fault_user_mapping","virt/kvm/guest_memfd.c::__kvm_gmem_create"],"text":"Invalidation pairs start with end: punch round truncate, error round notice delayed, release full range after clearing. Fault moves checks to acquire to retry, error or install. Creation unwinds in reverse."},{"sids":["virt/kvm/kvm_main.c::kvm_mmu_notifier_invalidate_range_end","virt/kvm/kvm_main.c::kvm_create_vm_debugfs","virt/kvm/kvm_main.c::kvm_arch_create_vm_debugfs","virt/kvm/kvm_main.c::kvm_create_vm"],"text":"MMU end forwards with inherited blocking and wakes single waiter at zero depth. Debug runs generic then arch hook, discarding on exhaustion. VM orders alloc, capture, setup, init, enable, notify, debug and publish with unwind."},{"sids":["virt/kvm/kvm_main.c::kvm_get_dirty_log_protect","virt/kvm/kvm_main.c::kvm_clear_dirty_log_protect","virt/kvm/kvm_main.c::kvm_handle_gfn_range","virt/kvm/kvm_main.c::kvm_vm_set_mem_attributes","virt/kvm/kvm_main.c::kvm_pre_set_memory_attributes"],"text":"Protective query shares manually or harvests with re-arm and conditional flush. Selective clear masks only set bits. GFN clamps, skips empty, lazily locks, flushes on effect. Attr early-exits, pre-reserves, brackets with walks and yields."}],"structs":[{"sids":["virt/kvm/kvm_main.c::kvm_mmu_notifier_range","virt/kvm/kvm_main.c::kvm_mmu_notifier_return","virt/kvm/kvm_main.c::kvm_mn_ret_t","virt/kvm/kvm_main.c::mmu_notifier_to_kvm","virt/kvm/kvm_main.c::kvm_mmu_notifier_ops","virt/kvm/kvm_main.c::kvm_init_mmu_notifier","virt/kvm/kvm_main.c::kvm_mmu_notifier_invalidate_range_end","virt/kvm/kvm_main.c::kvm_mmu_notifier_clear_flush_young","virt/kvm/kvm_main.c::kvm_mmu_notifier_clear_young","virt/kvm/kvm_main.c::kvm_mmu_notifier_test_young","virt/kvm/kvm_main.c::kvm_mmu_notifier_release"],"text":"Range carries dual-space bounds, handler, lock hook and flags. Result reports work and overlap; helper derives VM. Ops supply start, end, flush-clear, clear, test and release."},{"sids":["virt/kvm/guest_memfd.c::kvm_gmem_vm_ops","virt/kvm/guest_memfd.c::kvm_gmem_fops","virt/kvm/guest_memfd.c::kvm_gmem_aops","virt/kvm/guest_memfd.c::kvm_gmem_iops","virt/kvm/guest_memfd.c::kvm_gmem_setattr","virt/kvm/guest_memfd.c::kvm_gmem_migrate_folio","virt/kvm/guest_memfd.c::kvm_gmem_error_folio","virt/kvm/guest_memfd.c::kvm_gmem_free_folio","virt/kvm/guest_memfd.c::kvm_gmem_super_operations","virt/kvm/guest_memfd.c::kvm_gmem_init_fs_context","virt/kvm/guest_memfd.c::kvm_gmem_fs","virt/kvm/kvm_main.c::kvm_create_vm_debugfs"],"text":"Guest ops cover fault plus policy, map and release, dirty and migrate and error, rejected setattr, super alloc and free with named type. Debug stats hold VM-wide plus per-VCPU slots with ownership marks."},{"sids":["virt/kvm/kvm_main.c::ITOA_MAX_LEN","virt/kvm/kvm_main.c::halt_poll_ns_grow","virt/kvm/kvm_main.c::halt_poll_ns_grow_start","virt/kvm/kvm_main.c::halt_poll_ns_shrink","virt/kvm/kvm_main.c::KVM_EVENT_CREATE_VM","virt/kvm/kvm_main.c::KVM_EVENT_DESTROY_VM","virt/kvm/kvm_main.c::KVM_COMPAT.alt_1","virt/kvm/kvm_main.c::KVM_COMPAT.alt_2","virt/kvm/kvm_main.c::kvm_no_compat_ioctl","virt/kvm/kvm_main.c::kvm_no_compat_open","virt/kvm/kvm_main.c::kvm_lock","virt/kvm/kvm_main.c::kvm_vcpu_cache","virt/kvm/kvm_main.c::kvm_preempt_ops","virt/kvm/kvm_main.c::kvm_running_vcpu","virt/kvm/kvm_main.c::kvm_debugfs_dir","virt/kvm/kvm_main.c::stat_fops_per_vm.alt_1","virt/kvm/kvm_main.c::kvm_createvm_count","virt/kvm/kvm_main.c::kvm_active_vms","virt/kvm/kvm_main.c::cpu_kick_mask","virt/kvm/kvm_main.c::halt_poll_ns","virt/kvm/kvm_main.c::allow_unsafe_mappings","virt/kvm/kvm_main.c::CREATE_TRACE_POINTS","virt/kvm/guest_memfd.h::__KVM_GUEST_MEMFD_H__","virt/kvm/kvm_main.c::KVM_SET_USER_MEMORY_REGION_V1_FLAGS"],"text":"Facts: buffer twelve; poll grow two, start ten thousand, shrink two; events zero and one; V1 flags log plus read-only; compat handler or reject; globals track VMs, VCPUs, preemption, kicks, polling, mappings, tracepoints."}],"stubs":[]}
