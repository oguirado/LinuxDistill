e.alt_1","arch/x86/include/asm/apic.h::apic_write.alt_2","include/linux/printk.h::printk_once.alt_1","include/linux/printk.h::printk_once.alt_2","arch/x86/include/asm/apic.h::apic_eoi.alt_1","arch/x86/include/asm/apic.h::apic_eoi.alt_2","arch/x86/include/asm/apic.h::apic_is_x2apic_enabled","arch/x86/include/asm/apic.h::apic_pr_verbose","arch/x86/include/asm/apic.h::native_apic_msr_read.alt_1","arch/x86/include/asm/apic.h::native_apic_msr_read.alt_2","arch/x86/include/asm/apic.h::read_apic_id.alt_1","arch/x86/include/asm/apic.h::apic_dbg","arch/x86/lib/string_32.c::strncmp","include/linux/percpu-defs.h::per_cpu","include/linux/smp.h::smp_processor_id.alt_1","include/linux/smp.h::smp_processor_id.alt_2","include/asm-generic/bug.h::WARN_ON_ONCE.alt_1","include/asm-generic/bug.h::WARN_ON_ONCE.alt_2","include/asm-generic/bug.h::WARN_ON_ONCE.alt_3","include/asm-generic/io.h::readl.alt_2","include/linux/cleanup.h::guard","include/linux/cpumask.h::for_each_cpu","arch/x86/include/asm/apic.h::__apic_send_IPI_mask","arch/x86/include/asm/apic.h::apic_pr_debug","arch/x86/include/asm/apic.h::native_apic_mem_read","arch/x86/include/asm/apic.h::native_apic_mem_write","arch/x86/include/asm/apicdef.h::SET_APIC_LOGICAL_ID","arch/x86/include/asm/apicdef.h::SET_XAPIC_DEST_FIELD","arch/x86/include/asm/cpufeature.h::cpu_feature_enabled","arch/x86/include/asm/i8259.h::nr_legacy_irqs"],"text":"External MSR, APIC, IRQ-flag, CPU-feature, logging, mask, MMIO and topology helpers are referenced but owned elsewhere. Only observed use is described."}],"locks":[{"sids":["arch/x86/kernel/apic/apic.c::enable_IR_x2apic","arch/x86/kernel/apic/apic.c::lapic_suspend","arch/x86/kernel/apic/apic.c::lapic_resume"],"text":"Remap preserves IOAPIC, holds IRQs off across masking and selection until legacy restored, declines if skipped. Suspend snapshots only if enabled then disables. Resume quiets, restores base, keeps error masked, re-enables remapping."},{"sids":["arch/x86/kernel/apic/apic_numachip.c::numachip_send_IPI_one"],"text":"Compares high parts with preemption off. Match uses local path with IRQs masked, else fabric write with NMI for NMI vector else fixed."},{"sids":["arch/x86/kernel/apic/io_apic.c::ioapic_mutex","arch/x86/kernel/apic/io_apic.c::io_apic_sync","arch/x86/kernel/apic/io_apic.c::mask_ioapic_irq","arch/x86/kernel/apic/io_apic.c::eoi_ioapic_pin","arch/x86/kernel/apic/io_apic.c::ioapic_zap_locks"],"text":"Mask and ack hold spinlock with IRQs saved, mask with read fence. Mutex serialises management. Zap reinits spinlock for reuse."}],"pass":1,"phase_map":[{"anchor":"HB-KPAPER-001/hb-s5.p14","crown":"A","phase":"F0"},{"anchor":"HB-KPAPER-001/hb-s5.p04","crown":"A","phase":"F2"}],"schema":"lx.dossier.v1","state_machines":[{"sids":["arch/x86/kernel/apic/apic.c::anon_1","arch/x86/kernel/apic/apic.c::x2apic_state","arch/x86/kernel/apic/apic.c::x2apic_enable","arch/x86/kernel/apic/apic.c::x2apic_mode","arch/x86/kernel/apic/apic.c::check_x2apic.alt_1","arch/x86/kernel/apic/apic.c::check_x2apic.alt_2","arch/x86/kernel/apic/apic.c::x2apic_setup"],"text":"Four markers: lower inactive, upper active. Activation off-to-on only. Detection records firmware and lock state. Secondaries follow boot, warn on mismatch, enable if global active else clear. Without support, firmware-enabled disables LAPIC."},{"sids":["arch/x86/kernel/apic/ipi.c::apic_mem_wait_icr_idle_timeout","arch/x86/kernel/apic/ipi.c::apic_mem_wait_icr_idle"],"text":"Idle sync shares busy test. One form retries with delay up to bound reporting busy else success, other spins relaxed until idle."}],"structs":[{"sids":["arch/x86/kernel/apic/apic.c::APIC_IR_REGS","arch/x86/kernel/apic/apic.c::APIC_IR_BITS","arch/x86/kernel/apic/apic.c::APIC_IR_MAPSIZE","arch/x86/kernel/apic/apic.c::apic_ir"],"text":"Register view overlays machine-word array and 32-bit registers over same storage. Bits equal registers times 32, words equal bits divided by word width."},{"sids":["arch/x86/kernel/apic/apic.c::anon_2","arch/x86/kernel/apic/apic.c::apic_pm_state","arch/x86/kernel/apic/apic.c::lapic_syscore_ops","arch/x86/kernel/apic/apic.c::lapic_syscore","arch/x86/kernel/apic/apic.c::init_lapic_sysfs"],"text":"Power saves ownership, id, priority, formats, spurious, timer and LVT entries plus thermal and MCE when large. Ops registered as syscore only if capable."},{"sids":["arch/x86/kernel/apic/apic_flat_64.c::__ro_after_init.alt_1","arch/x86/kernel/apic/apic_flat_64.c::__ro_after_init.alt_2","arch/x86/kernel/apic/apic_noop.c::__ro_after_init","arch/x86/kernel/apic/apic_numachip.c::__refconst.alt_1","arch/x86/kernel/apic/apic_numachip.c::__refconst.alt_2"],"text":"Tables share identity, selection, flags, translation, limit, extraction, dest, sends, wakeup, and register ops. Flat caps 254, Numachip full range."},{"sids":["arch/x86/kernel/apic/io_apic.c::ioapic_dynirq_base","arch/x86/kernel/apic/io_apic.c::ioapic_initialized","arch/x86/kernel/apic/io_apic.c::irq_pin_list","arch/x86/kernel/apic/io_apic.c::mp_chip_data","arch/x86/kernel/apic/io_apic.c::mp_ioapic_gsi","arch/x86/kernel/apic/io_apic.c::ioapic","arch/x86/kernel/apic/io_apic.c::ioapics","arch/x86/kernel/apic/io_apic.c::nr_ioapics","arch/x86/kernel/apic/io_apic.c::gsi_top","arch/x86/kernel/apic/io_apic.c::mp_irqs","arch/x86/kernel/apic/io_apic.c::mp_irq_entries","arch/x86/kernel/apic/io_apic.c::mp_bus_id_to_type","arch/x86/kernel/apic/io_apic.c::__ro_after_init","arch/x86/kernel/apic/io_apic.c::ioapic_chip","arch/x86/kernel/apic/io_apic.c::ioapic_ir_chip","arch/x86/kernel/apic/io_apic.c::io_apic","arch/x86/kernel/apic/io_apic.c::native_io_apic_read","arch/x86/kernel/apic/io_apic.c::MAX_PIRQS","arch/x86/kernel/apic/io_apic.c::pirq_entries","arch/x86/kernel/apic/io_apic.c::ioapic_pirq_setup","arch/x86/kernel/apic/init.c::pr_fmt","arch/x86/kernel/apic/io_apic.c::for_each_ioapic_reverse"],"text":"Keeps base, flags, counts, MP and bus tables, pin linkage, chip data, GSI ranges, descriptors. Window has index, data, EOI. PIRQ 8 entries init -1 reverse-filled. Logs use APIC prefix, reverse last-to-first."}],"stubs":[]}
