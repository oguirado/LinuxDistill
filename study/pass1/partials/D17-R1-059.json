{"dossier":"D17","entry_points":[],"exports":[{"sids":["include/uapi/linux/in.h::in_addr","include/uapi/linux/in.h::sockaddr_in","include/uapi/linux/in6.h::sockaddr_in6","include/uapi/linux/in6.h::ipv6_mreq","include/uapi/linux/inet_diag.h::inet_diag_req","include/uapi/linux/inet_diag.h::inet_diag_msg"],"text":"Stable contract for IPv4/IPv6 addresses, socket addresses, multicast and flow controls, and netlink diagnostics with filtering."}],"extracts":["001985d42d40cc3a7097b2b936ec1c7b72baa2a4d7418069283c5cfa9b73315f","f9fb71845f042102917c2134ae0b38cb9aabb76f9b36057bcd489e846c81b7ba"],"gpl_spec":"PASS","hazards":[{"sids":["include/uapi/linux/in.h::ip_msfilter","include/uapi/linux/in.h::IP_MSFILTER_SIZE","include/uapi/linux/in.h::group_filter","include/uapi/linux/in.h::GROUP_FILTER_SIZE","include/uapi/linux/inet_diag.h::inet_diag_hostcond","include/uapi/linux/in6.h::in6_addr"],"text":"Size trailing lists with helpers not base size or truncation/overrun occurs. Union aliases share bytes; write via one visible via other. Check bytecode offsets and addr tails."}],"invariants":[{"sids":["include/uapi/linux/in.h::IP_MSFILTER_SIZE","include/uapi/linux/in.h::GROUP_FILTER_SIZE","include/uapi/linux/in.h::ip_msfilter","include/uapi/linux/in.h::group_filter"],"text":"Variable filter size equals base size minus placeholder plus count times element size; one helper uses 32-bit entries, the other socket storage."}],"locks":[],"pass":1,"phase_map":[{"anchor":"HB-KPAPER-001/hb-s5.p14","crown":"A","phase":"F0"},{"anchor":"HB-KPAPER-001/hb-s5.p04","crown":"A","phase":"F1"},{"anchor":"HB-KPAPER-001/hb-s5.p04","crown":"A","phase":"F2"},{"anchor":"HB-KPAPER-001/hb-s5.p05","crown":"A","phase":"F3"},{"anchor":"HB-KPAPER-001/hb-s5.p05","crown":"A","phase":"F4"},{"anchor":"HB-KPAPER-001/hb-s5.p10","crown":"A","phase":"F5"},{"anchor":"HB-KPAPER-001/hb-s5.p13","crown":"A","phase":"F6"}],"schema":"lx.dossier.v1","state_machines":[{"sids":["include/uapi/linux/inet_diag.h::inet_diag_bc_op","include/uapi/linux/inet_diag.h::anon_2","include/uapi/linux/inet_diag.h::inet_diag_hostcond","include/uapi/linux/inet_diag.h::inet_diag_markcond"],"text":"Ops carry opcode plus yes/no jump offsets. Opcodes 0-up: NOP, JUMP, SPORT/DSPORT ordered/equality, AUTO, SADDR/DADDR, DEV, MARK, CGROUP. Addr test has family, prefixlen, port, trailing bytes. Mark test has value/mask."}],"structs":[{"sids":["include/uapi/linux/in.h::in_addr","include/uapi/linux/in.h::in_pktinfo","include/uapi/linux/in.h::__SOCK_SIZE__","include/uapi/linux/in.h::sockaddr_in","include/uapi/linux/in.h::sin_zero","include/uapi/linux/in.h::ip_mreq","include/uapi/linux/in.h::ip_mreqn","include/uapi/linux/in.h::ip_mreq_source","include/uapi/linux/in.h::ip_msfilter","include/uapi/linux/in.h::ip_msfilter.anon_1","include/uapi/linux/in.h::group_req","include/uapi/linux/in.h::group_source_req","include/uapi/linux/in.h::group_filter","include/uapi/linux/in.h::group_filter.anon_1","include/uapi/linux/in.h::group_filter.anon_1.anon_1","include/uapi/linux/in.h::group_filter.anon_1.anon_2","include/uapi/linux/in6.h::in6_addr","include/uapi/linux/in6.h::in6_addr.anon_1","include/uapi/linux/in6.h::s6_addr","include/uapi/linux/in6.h::s6_addr16","include/uapi/linux/in6.h::s6_addr32","include/uapi/linux/in6.h::sockaddr_in6","include/uapi/linux/in6.h::ipv6_mreq","include/uapi/linux/in6.h::ipv6mr_acaddr","include/uapi/linux/in6.h::in6_flowlabel_req"],"text":"IPv4 addr is single 32b net-order word. sockaddr_in is family, port, addr, pad to 16B; pad aliased sin_zero. pktinfo is ifindex plus two addrs. Membership: group+iface; plus ifindex; triple net words; msfilter with mode/count plus trailing list as [1] and flex; generic idx+storage with optional source; filter dual aux/plain views. IPv6 addr 16B union as bytes/u16/u32 with short aliases. sockaddr_in6 family, port, flow, addr, scope. mreq group+ifindex with acaddr alias. Flow req dest, label, action, share, flags, expiry, linger, pad, opts."},{"sids":["include/uapi/linux/inet_diag.h::inet_diag_sockid","include/uapi/linux/inet_diag.h::INET_DIAG_NOCOOKIE","include/uapi/linux/inet_diag.h::inet_diag_req","include/uapi/linux/inet_diag.h::inet_diag_req_v2","include/uapi/linux/inet_diag.h::inet_diag_req_raw","include/uapi/linux/inet_diag.h::inet_diag_msg","include/uapi/linux/inet_diag.h::anon_3","include/uapi/linux/inet_diag.h::inet_diag_meminfo","include/uapi/linux/inet_diag.h::inet_diag_sockopt","include/uapi/linux/inet_diag.h::tcpvegas_info","include/uapi/linux/inet_diag.h::tcp_dctcp_info","include/uapi/linux/inet_diag.h::tcp_bbr_info","include/uapi/linux/inet_diag.h::tcp_cc_info"],"text":"Sockid: ports, addrs as 4 words, ifindex, 2-word cookie, all-ones means none. Req: family, len/proto, extmask, pad, statemask, tablemask, sockid; raw adds proto. Reply: family, state, timer, retrans, sockid, expiry, queues, user, inode; timers off/on/keepalive/timewait/zeroprobe/delayack. Meminfo 4 counters. Sockopt 1b flags errqueue, kind, freebind, hdrincl, mcastloop/all, transp, nofrag, noport, rfc4884, defer. Vegas en, cnt, rtt, min. DCTCP 2x16 en/state + 3x32 alpha/ecn/tot. BBR bwlo/hi=u64Bps, minrtt, gains<<8. Union selects one."},{"sids":["include/uapi/linux/in.h::anon_1","include/uapi/linux/in.h::IPPROTO_IP","include/uapi/linux/in.h::IPPROTO_ICMP","include/uapi/linux/in.h::IPPROTO_IGMP","include/uapi/linux/in.h::IPPROTO_IPIP","include/uapi/linux/in.h::IPPROTO_TCP","include/uapi/linux/in.h::IPPROTO_EGP","include/uapi/linux/in.h::IPPROTO_PUP","include/uapi/linux/in.h::IPPROTO_UDP","include/uapi/linux/in.h::IPPROTO_IDP","include/uapi/linux/in.h::IPPROTO_TP","include/uapi/linux/in.h::IPPROTO_DCCP","include/uapi/linux/in.h::IPPROTO_IPV6","include/uapi/linux/in.h::IPPROTO_RSVP","include/uapi/linux/in.h::IPPROTO_GRE","include/uapi/linux/in.h::IPPROTO_ESP","include/uapi/linux/in.h::IPPROTO_AH","include/uapi/linux/in.h::IPPROTO_MTP","include/uapi/linux/in.h::IPPROTO_BEETPH","include/uapi/linux/in.h::IPPROTO_ENCAP","include/uapi/linux/in.h::IPPROTO_PIM","