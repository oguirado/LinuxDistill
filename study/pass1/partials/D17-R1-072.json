tors eight max 1024. UDP options cover cork encap no checksum v6 segment and gro. Guards ensure single inclusion."},{"sids":["include/uapi/linux/usb/ch9.h::usb_ctrlrequest","include/uapi/linux/usb/ch9.h::usb_descriptor_header","include/uapi/linux/usb/ch9.h::usb_device_descriptor","include/uapi/linux/usb/ch9.h::USB_DT_DEVICE_SIZE","include/uapi/linux/usb/ch9.h::usb_config_descriptor","include/uapi/linux/usb/ch9.h::USB_DT_CONFIG_SIZE","include/uapi/linux/usb/ch9.h::usb_interface_descriptor","include/uapi/linux/usb/ch9.h::USB_DT_INTERFACE_SIZE","include/uapi/linux/usb/ch9.h::usb_endpoint_descriptor","include/uapi/linux/usb/ch9.h::USB_DT_ENDPOINT_SIZE","include/uapi/linux/usb/ch9.h::USB_DT_ENDPOINT_AUDIO_SIZE","include/uapi/linux/usb/ch9.h::usb_string_descriptor","include/uapi/linux/usb/ch9.h::usb_string_descriptor.anon_1","include/uapi/linux/usb/ch9.h::USB_DIR_OUT","include/uapi/linux/usb/ch9.h::USB_DIR_IN","include/uapi/linux/usb/ch9.h::USB_TYPE_MASK","include/uapi/linux/usb/ch9.h::USB_TYPE_STANDARD","include/uapi/linux/usb/ch9.h::USB_TYPE_CLASS","include/uapi/linux/usb/ch9.h::USB_TYPE_VENDOR","include/uapi/linux/usb/ch9.h::USB_TYPE_RESERVED","include/uapi/linux/usb/ch9.h::USB_RECIP_MASK","include/uapi/linux/usb/ch9.h::USB_RECIP_DEVICE","include/uapi/linux/usb/ch9.h::USB_RECIP_INTERFACE","include/uapi/linux/usb/ch9.h::USB_RECIP_ENDPOINT","include/uapi/linux/usb/ch9.h::USB_RECIP_OTHER","include/uapi/linux/usb/ch9.h::USB_DT_DEVICE","include/uapi/linux/usb/ch9.h::USB_DT_CONFIG","include/uapi/linux/usb/ch9.h::USB_DT_STRING","include/uapi/linux/usb/ch9.h::USB_DT_INTERFACE","include/uapi/linux/usb/ch9.h::USB_DT_ENDPOINT","include/uapi/linux/usb/ch9.h::USB_DT_BOS","include/uapi/linux/usb/ch9.h::USB_DT_DEVICE_CAPABILITY","include/uapi/linux/usb/ch9.h::USB_DT_SS_ENDPOINT_COMP","include/uapi/linux/usb/ch9.h::USB_CONFIG_ATT_ONE","include/uapi/linux/usb/ch9.h::USB_CONFIG_ATT_SELFPOWER","include/uapi/linux/usb/ch9.h::USB_CONFIG_ATT_WAKEUP","include/uapi/linux/usb/ch9.h::USB_MAX_ST