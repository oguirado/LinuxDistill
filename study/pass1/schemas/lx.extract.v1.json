{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "lx.extract.v1",
 "title": "One Muse map-lane extract over routed lx fragments (spec only, no code)",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "dossier", "lane", "pass", "prefix_sha256", "prompt_sha256", "index_id", "sids_read", "findings", "absent"],
 "properties": {
  "schema": {"const": "lx.extract.v1"},
  "dossier": {"type": "string", "pattern": "^D(0[1-9]|1[0-7])$"},
  "lane": {"type": "integer", "minimum": 1},
  "pass": {"type": "integer", "minimum": 1, "maximum": 3},
  "prefix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "index_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "sids_read": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 200}},
  "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["kind", "text", "sids"],
   "properties": {
    "kind": {"enum": ["export", "invariant", "lock", "struct", "state_machine", "entry_point", "hazard", "abi_constant", "stub"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 1200},
    "sids": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 200}}}}},
  "absent": {"type": "array", "items": {"type": "string"}}
 }
}
